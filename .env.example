# Copy to .env and fill in. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────────────────────────────
# Supabase: Project → Connect (top bar) → "Session pooler" → URI. Use the SESSION pooler (port 5432):
# the direct host db.<ref>.supabase.co is IPv6-only and usually unreachable from Docker on Windows/Mac.
# Replace [YOUR-PASSWORD] with the database password (Project Settings → Database → Reset password if unknown).
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A, ? → %3F, % → %25).
# Then create the tables once:  docker compose run --rm --no-deps backend python -m app.migrate
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Only for the optional local database (docker compose --profile localdb up) when DATABASE_URL is empty.
POSTGRES_PASSWORD=amhews

# Secret that signs AMHEWS sign-in tokens (the app issues its own; not the Supabase JWT secret). 32+ random characters.
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

# Master key that siren command keys are derived from. Keep secret; rotate by re-provisioning sirens.
SIREN_SIGNING_KEY=change-me-siren-signing-key

# NASA Earthdata bearer token for GPM IMERG (https://urs.earthdata.nasa.gov -> Generate Token).
# Then enable the source: update data_sources set enabled = true where code = 'gpm_imerg';
EARTHDATA_TOKEN=

# Folder where MOSDAC's official download tool saves INSAT-3D/3DR/3DS HDF5 files.
# Then enable the source: update data_sources set enabled = true where code = 'insat';
INSAT_INBOX_DIR=

# Open-Meteo grid spacing and polling (free tier: ~10,000 location-calls per day)
NEPAL_GRID_STEP_DEG=0.5
GLOBAL_GRID_STEP_DEG=10
NEPAL_WEATHER_POLL_S=3600
GLOBAL_WEATHER_POLL_S=10800

# First admin account, created at startup only when no users exist yet. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI analyst and assistant. Set ONE key; leave both empty to switch the AI features off.
# Free: Google Gemini key from https://aistudio.google.com/apikey  (free tier has daily limits)
GEMINI_API_KEY=
# Paid, strongest: Claude key from https://console.anthropic.com  (used first when set)
ANTHROPIC_API_KEY=
# AI_PROVIDER=auto     # auto | anthropic | gemini | openai_compat (any OpenAI-compatible API)
# AI_MODEL=            # empty = default (claude-opus-5-5 / gemini-flash-latest)
# AI_FALLBACK_MODEL=   # used when the main model is busy; empty = gemini-flash-lite-latest for Gemini, off = none
# AI_BASE_URL=         # openai_compat only, e.g. https://api.groq.com/openai/v1/
# AI_API_KEY=          # openai_compat only
# AI_INTERVAL_S=       # scheduled analysis interval in seconds (default 1800 Claude, 10800 Gemini)
# AI_EFFORT=medium     # low | medium | high | xhigh | max
# AI_ENABLED=true      # false stops the scheduled analyst
# AI_CHAT_PER_HOUR=30  # assistant questions per user per hour
# AI_PROPOSE_MESSAGES=true  # AI drafts resident messages for WATCH+ findings; approvers edit, send or reject them

# AI visual disaster detection (photos). See docs/visual-disaster-detection.md
# VISUAL_MAX_UPLOAD_MB=10
# VISUAL_UPLOADS_PER_HOUR=20
# ALLOW_SELF_REGISTRATION=true    # residents can create viewer accounts to report photos and receive alerts

# Notifications. External channels are SIMULATED (recorded, not sent) until this is true.
NOTIFY_EXTERNAL_ENABLED=false
# NOTIFY_MAX_PER_DAY=10           # per person, CRITICAL never limited
# NOTIFY_COOLDOWN_MIN=30
# Phone notifications via the free ntfy app (residents pick a private topic in My alerts)
# NTFY_SERVER=https://ntfy.sh
# MASS_ALERT_NTFY_TOPIC=          # every sent message is also published once to this topic ("send to all phones")
# NTFY_TOKEN=                     # only for a protected / self-hosted ntfy server
# PUBLIC_APP_URL=                 # link opened when the phone notification is tapped
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMS (Twilio REST API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Web Push (also needs the pywebpush package and a frontend service worker)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
