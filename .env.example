# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=amhews

# JWT secret used to verify operator tokens (use your Supabase project's JWT secret in production)
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

# Master key that siren command keys are derived from. Keep secret; rotate by re-provisioning sirens.
SIREN_SIGNING_KEY=change-me-siren-signing-key

# NASA Earthdata bearer token for GPM IMERG (https://urs.earthdata.nasa.gov -> Generate Token).
# Then enable the source: update data_sources set enabled = true where code = 'gpm_imerg';
EARTHDATA_TOKEN=

# Folder where MOSDAC's official download tool saves INSAT-3D/3DR/3DS HDF5 files.
# Then enable the source: update data_sources set enabled = true where code = 'insat';
INSAT_INBOX_DIR=

# Open-Meteo grid spacing and polling (free tier: ~10,000 location-calls per day)
NEPAL_GRID_STEP_DEG=0.5
GLOBAL_GRID_STEP_DEG=10
NEPAL_WEATHER_POLL_S=3600
GLOBAL_WEATHER_POLL_S=10800

# First admin account, created at startup only when no users exist yet. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
